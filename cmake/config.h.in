/* src/include/ngspice/config.h -- generated by CMake from cmake/config.h.in
 *
 * This is the CMake counterpart of the config.h that autoheader/configure
 * generate.  Keep the macro names in sync with configure.ac; the checks
 * themselves live in cmake/NgspiceConfigHeader.cmake.
 */

#ifndef NGSPICE_CONFIG_H
#define NGSPICE_CONFIG_H

/* ---------------------------------------------------------------- */
/* Package identification                                            */
/* ---------------------------------------------------------------- */
#define PACKAGE "@PROJECT_NAME@"
#define PACKAGE_NAME "@PROJECT_NAME@"
#define PACKAGE_TARNAME "@PROJECT_NAME@"
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define PACKAGE_STRING "@PROJECT_NAME@ @PROJECT_VERSION@"
#define PACKAGE_BUGREPORT "http://ngspice.sourceforge.net/bugrep.html"
#define VERSION "@PROJECT_VERSION@"
/* 1=MinGW 2=Cygwin 3=FreeBSD 4=OpenBSD 5=Solaris 6=Linux 7=macOS 0=other */
#define OS_COMPILED @NGSPICE_OS_COMPILED@

/* Build date; honours SOURCE_DATE_EPOCH for reproducible builds */
#define NGSPICEBUILDDATE "@NGSPICE_BUILD_DATE@"

/* Installation directories, as seen at run time */
#define NGSPICEBINDIR "@NGSPICEBINDIR@"
#define NGSPICEDATADIR "@NGSPICEDATADIR@"
/* Architecture dependent files, i.e. where the .cm code models live */
#define NGSPICELIBDIR "@NGSPICELIBDIR@"

/* ---------------------------------------------------------------- */
/* Major ngspice options                                             */
/* ---------------------------------------------------------------- */
#cmakedefine XSPICE 1
#cmakedefine CIDER 1
#cmakedefine OSDI 1
#cmakedefine KLU 1
#cmakedefine RFSPICE 1
#cmakedefine WITH_PSS 1
#cmakedefine NDEV 1
#cmakedefine WANT_SENSE2 1
#cmakedefine USE_OMP 1
#cmakedefine SHARED_MODULE 1
#cmakedefine TCL_MODULE 1
#cmakedefine HAS_WINGUI 1
#cmakedefine HAS_RELPATH 1
#cmakedefine EXT_ASC 1
/* NGDEBUG is set per configuration via target_compile_definitions,
   because config.h is generated once for all configurations. */
#cmakedefine EXPERIMENTAL_CODE 1
#cmakedefine EXP_DEV 1
#cmakedefine NOINTHELP 1

/* Numerics / algorithm tweaks */
#cmakedefine NOBYPASS 1
#cmakedefine CAPBYPASS 1
#cmakedefine NODELIMITING 1
#cmakedefine PREDICTOR 1
#cmakedefine NEWPRED 1

/* Debug switches */
#cmakedefine FTEDEBUG 1
#cmakedefine CPDEBUG 1
#cmakedefine SENSDEBUG 1
#cmakedefine ASDEBUG 1
#cmakedefine STEPDEBUG 1
#cmakedefine PZDEBUG 1
#cmakedefine D_DBG_BLOCKTIMES 1
#cmakedefine D_DBG_SMALLTIMES 1

/* XSPICE IPC */
#cmakedefine IPC_UNIX_SOCKETS 1
#cmakedefine IPC_DEBUG_VIA_STDIO 1

/* ---------------------------------------------------------------- */
/* Optional external libraries                                       */
/* ---------------------------------------------------------------- */
#cmakedefine HAVE_LIBFFTW3 1
#cmakedefine HAVE_LIBSNDFILE 1
#cmakedefine HAVE_LIBSAMPLERATE 1
#cmakedefine HAVE_LIBGC 1
#cmakedefine HAVE_LIBM 1
#cmakedefine HAVE_LIBPTHREAD 1
#cmakedefine HAVE_LIBXFT 1
#cmakedefine HAVE_GNUREADLINE 1
#cmakedefine HAVE_BSDEDITLINE 1
#cmakedefine HAVE_TERMCAP 1
#cmakedefine X_DISPLAY_MISSING 1

/* ---------------------------------------------------------------- */
/* Headers                                                           */
/* ---------------------------------------------------------------- */
#cmakedefine HAVE_ALLOCA_H 1
#cmakedefine HAVE_ARPA_INET_H 1
#cmakedefine HAVE_CTYPE_H 1
#cmakedefine HAVE_DIRENT_H 1
#cmakedefine HAVE_DLFCN_H 1
