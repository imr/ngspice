#cmakedefine HAVE_WORKING_VFORK 1

/* ---------------------------------------------------------------- */
/* Types, declarations, misc                                         */
/* ---------------------------------------------------------------- */
#cmakedefine HAVE__BOOL 1
#cmakedefine STDC_HEADERS 1
#cmakedefine TIME_WITH_SYS_TIME 1
#cmakedefine HAVE_TM_ZONE 1
#cmakedefine HAVE_STRUCT_TM_TM_ZONE 1
