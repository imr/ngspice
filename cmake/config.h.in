#cmakedefine YYTEXT_POINTER 1

#cmakedefine01 HAVE_DECL_ISINF
#cmakedefine01 HAVE_DECL_ISNAN
#cmakedefine01 HAVE_DECL_TZNAME

/* select() argument types (POSIX values; overridden for Windows) */
#define SELECT_TYPE_ARG1 @SELECT_TYPE_ARG1@
#define SELECT_TYPE_ARG234 @SELECT_TYPE_ARG234@
#define SELECT_TYPE_ARG5 @SELECT_TYPE_ARG5@

#endif /* NGSPICE_CONFIG_H */
